# Only needed when running the agent OUTSIDE the cluster (local dev). In-cluster config lives in deploy/20-agent.yaml.
ANTHROPIC_API_KEY=
HEALER_DRY_RUN=true
HEALER_ALLOWED_NAMESPACES=demo
HEALER_LLM_PROVIDER=anthropic        # or "rules" for fully offline/deterministic
HEALER_MODEL=claude-sonnet-5-5
HEALER_PROMETHEUS_URL=http://localhost:9090   # make ui-prometheus
HEALER_LOKI_URL=http://localhost:3100         # kubectl -n monitoring port-forward svc/loki 3100:3100
HEALER_INCIDENT_DIR=./incidents
